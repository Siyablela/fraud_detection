# Local development values for docker compose. Copy to .env and change every
# secret. .env is git-ignored; never commit real credentials.
#   cp .env.example .env

# PostgreSQL
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud
POSTGRES_PASSWORD=local-dev-postgres-password

# Redis
REDIS_PASSWORD=local-dev-redis-password

# Kafka
KAFKA_TOPIC_NAME=transactions
KAFKA_TOPIC_PARTITIONS=6
KAFKA_CONSUMER_GROUP_ID=fraud-worker

# Keycloak (identity provider) admin console: http://localhost:8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-dev-keycloak-admin-password
# Client-credentials secrets for the two API clients defined in infra/keycloak/fraud-realm.json
FRAUD_ANALYST_CLIENT_SECRET=local-dev-analyst-secret
FRAUD_RULES_ADMIN_CLIENT_SECRET=local-dev-rules-admin-secret

# Host ports (bound to 127.0.0.1 only)
API_HOST_PORT=8000
KEYCLOAK_HOST_PORT=8080
KAFKA_HOST_PORT=29092
POSTGRES_HOST_PORT=5432
WORKER_METRICS_HOST_PORT=9100

# Tuning
OBSERVABILITY_LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=100
