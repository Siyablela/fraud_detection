# Infrastructure credentials and names
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change-me

# Service connectivity used by Python services (container network values)
DATABASE_URL=postgresql://fraud_user:change-me@postgres:5432/fraud_detection
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_NAME=transactions_topic
KAFKA_DLQ_TOPIC_NAME=transactions_topic.dlq
KAFKA_CONSUMER_GROUP_ID=fraud-worker-group
FRAUD_RULES_CONFIG_PATH=/config/rules.json

# JWT validation settings
JWT_ISSUER=http://localhost:8081/realms/fraud
JWT_AUDIENCE=fraud-api
JWT_JWKS_URL=http://localhost:8081/realms/fraud/protocol/openid-connect/certs
JWT_PUBLIC_KEY_PATH=
JWT_ALGORITHMS=RS256
JWT_REQUIRED_SCOPE_FOR_TRANSACTION_READ=fraud:transactions:read
AUTH_TOKEN_ENDPOINT_ENABLED=true
# Public client used by human-facing tools; prefer PKCE in the client application.
KEYCLOAK_TOKEN_CLIENT_ID=fraud-cli
KEYCLOAK_TOKEN_CLIENT_SECRET=
# Confidential client used by backend services; client credentials grant should be used here.
KEYCLOAK_SERVICE_CLIENT_ID=fraud-service-cli
KEYCLOAK_SERVICE_CLIENT_SECRET=
KEYCLOAK_SERVICE_TOKEN_SCOPE=
# Local bootstrap values that are created automatically by the app startup flow.
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_DEMO_USERNAME=demo
KEYCLOAK_DEMO_PASSWORD=demo

# Kafka mTLS settings
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SSL_TRUSTSTORE_PATH=.secrets/kafka-ca.pem
KAFKA_SSL_KEYSTORE_CERT_PATH=.secrets/kafka-client.crt
KAFKA_SSL_KEYSTORE_KEY_PATH=.secrets/kafka-client.key
KAFKA_SSL_KEYSTORE_PASSWORD=change-me
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true

# Runtime tuning
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Default rule values used when rules file is missing keys
DEFAULT_HIGH_VALUE_THRESHOLD=10000
DEFAULT_RESTRICTED_CATEGORIES={"GAMBLING": 5000, "CRYPTO": 5000}

# Integration test target
INTEGRATION_API_URL=http://localhost:8000
INTEGRATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INTEGRATION_KAFKA_TOPIC_NAME=transactions_topic
INTEGRATION_ACCESS_TOKEN=<JWT access token with fraud:transactions:read>

# Keycloak local development
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Security artifacts are provisioned externally in production
# .secrets/ is intentionally ignored and should not be committed.
