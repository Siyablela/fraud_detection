# Core app runtime
DATABASE_URL=postgresql://fraud_user:change-me@postgres:5432/fraud_detection
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change-me
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_NAME=transactions_topic
KAFKA_DLQ_TOPIC_NAME=transactions_topic.dlq
KAFKA_CONSUMER_GROUP_ID=fraud-worker-group
FRAUD_RULES_CONFIG_PATH=/config/rules.json

# Auth / Keycloak
JWT_ISSUER=http://keycloak:8080/realms/fraud
JWT_AUDIENCE=fraud-api
JWT_JWKS_URL=http://keycloak:8080/realms/fraud/protocol/openid-connect/certs
JWT_PUBLIC_KEY_PATH=
JWT_ALGORITHMS=RS256
JWT_REQUIRED_SCOPE_FOR_TRANSACTION_READ=fraud:transactions:read
JWT_REQUIRED_SCOPE_FOR_RULES_WRITE=fraud:rules:write
AUTH_TOKEN_ENDPOINT_ENABLED=true
KEYCLOAK_TOKEN_CLIENT_ID=fraud-cli
KEYCLOAK_TOKEN_CLIENT_SECRET=
KEYCLOAK_SERVICE_CLIENT_ID=fraud-service-cli
KEYCLOAK_SERVICE_CLIENT_SECRET=
KEYCLOAK_SERVICE_TOKEN_SCOPE=

# Kafka producer settings
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true

# App tuning
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Batch job
BATCH_JOB_ENABLED=false
BATCH_RUN_HOUR=2
BATCH_RUN_MINUTE=0

# Rule defaults
DEFAULT_HIGH_VALUE_THRESHOLD=10000
DEFAULT_RESTRICTED_CATEGORIES={"GAMBLING": 5000, "CRYPTO": 5000}

# Local bootstrap / test helpers
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_DEMO_USERNAME=demo
KEYCLOAK_DEMO_PASSWORD=demo

# Optional integration test values
INTEGRATION_API_URL=http://localhost:8000
INTEGRATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INTEGRATION_KAFKA_TOPIC_NAME=transactions_topic
INTEGRATION_ACCESS_TOKEN=<JWT access token with fraud:transactions:read>
